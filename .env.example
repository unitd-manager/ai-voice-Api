# --- Core ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=info
# 32+ chars; REQUIRED in production. Encrypts webhook secrets, tool headers, integration credentials.
ENCRYPTION_KEY=
# First user with this email becomes platform admin on registration
ADMIN_BOOTSTRAP_EMAIL=
CORS_ORIGINS=http://localhost:5173

# --- Database (MySQL via Prisma) ---
DATABASE_URL=mysql://voice:voicepass@localhost:3306/voice_agent

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Auth secrets: generate with `openssl rand -hex 48` ---
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_REFRESH_SECRET=change-me-too-change-me-too-change-me-too

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# --- Voice provider (Vapi) - requires your own account ---
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=

# --- LLM (OpenAI-compatible) ---
LLM_BASE_URL=
LLM_API_KEY=

# --- Embeddings ---
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# TEST ONLY: point the Stripe SDK at stripe-mock (e.g. http://127.0.0.1:12111). Leave empty in real environments.
STRIPE_API_URL=

# --- Object storage (S3-compatible) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email ---
SMTP_URL=
EMAIL_FROM=Voice Agent <no-reply@example.com>
