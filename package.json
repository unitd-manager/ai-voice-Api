{
  "name": "voice-agent-saas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/workers/index.js",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "seed": "node prisma/seed.js",
    "audit": "npm audit --omit=dev",
    "test:db": "vitest run -c vitest.db.config.js",
    "test:live": "LIVE_TESTS=1 vitest run -c vitest.live.config.js",
    "db:test-client": "node scripts/make-test-schema.mjs && prisma generate --schema prisma/schema.test.prisma",
    "db:ddl": "node scripts/dmmf-ddl.mjs",
    "check:prisma": "node scripts/check-prisma-usage.mjs",
    "openapi": "node scripts/gen-openapi.mjs",
    "make-admin": "node scripts/make-admin.mjs",
    "start:prod": "prisma migrate deploy && node src/server.js",
    "lint:syntax": "node scripts/check-syntax.mjs",
    "prisma:migrate:init": "prisma migrate dev --name init",
    "test:infra": "vitest run -c vitest.infra.config.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.11",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.16",
    "pdf-parse": "^2.4.5",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "stripe": "^23.0.0",
    "swagger-ui-express": "^5.0.1",
    "undici": "^8.11.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@prisma/adapter-mariadb": "^6.19.3",
    "pino-pretty": "^13.2.0",
    "prisma": "^6.19.3",
    "s3rver": "^3.7.1",
    "smtp-server": "^3.19.18",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  }
}